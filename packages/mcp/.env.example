# Listmonk API base URL (the local Compose stack publishes it on port 9000)
LISTMONK_API_URL=http://localhost:9000/api

# Listmonk API user and token. For the local stack, `bun run stack:bootstrap-auth`
# creates the `api-admin` API user and writes its token to
# /tmp/listmonk-ops-api-token. In GitHub Actions, it also exports the token via
# GITHUB_ENV.
LISTMONK_USERNAME=api-admin
LISTMONK_API_TOKEN=
# Or read the token from a file (relative paths resolve from your home directory):
# LISTMONK_API_TOKEN_FILE=/tmp/listmonk-ops-api-token

# MCP HTTP server. It stays loopback-bound; exposing it further needs
# MCP_HTTP_ALLOWED_HOSTS, MCP_HTTP_ALLOWED_ORIGINS, and MCP_HTTP_AUTH_TOKEN.
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000
# MCP_HTTP_AUTH_TOKEN=
