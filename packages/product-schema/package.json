{
	"name": "@listmonk-ops/product-schema",
	"version": "0.0.0",
	"type": "module",
	"description": "Compiler-driven product schema for typed Listmonk email operations",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/imjlk/listmonk-ops"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"generated",
		"README.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"generate:contracts": "ttsx --project ./tsconfig.scripts.json ./scripts/generate-contract-schemas.ts",
		"generate:artifacts": "bun ./scripts/generate-artifacts.ts",
		"generate": "bun run generate:contracts && bun run generate:artifacts",
		"generate:check": "ttsx --project ./tsconfig.scripts.json ./scripts/generate-contract-schemas.ts -- --check && bun ./scripts/generate-artifacts.ts --check",
		"build": "bun run generate:check && bun run clean && ttsc -p tsconfig.build.json && esbuild src/index.ts --bundle --platform=neutral --format=esm --outfile=dist/index.js --minify",
		"typecheck": "ttsc --noEmit",
		"format": "ttsc format",
		"lint": "ttsc --noEmit",
		"lint:fix": "ttsc fix",
		"test": "bun run generate:check && bun test",
		"prepublishOnly": "bun run build && bun run test"
	},
	"devDependencies": {
		"@types/bun": "1.3.10",
		"esbuild": "0.27.4",
		"ttsc": "0.22.0",
		"typia": "13.2.0",
		"typescript": "7.0.2"
	}
}
